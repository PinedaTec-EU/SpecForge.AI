<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SpecForge.Domain\SpecForge.Domain.csproj" />
    <ProjectReference Include="..\SpecForge.OpenAICompatible\SpecForge.OpenAICompatible.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\tools\render-cli-workflow-html.js"
          Link="tools\render-cli-workflow-html.js"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\dist\*.js"
          LinkBase="dist"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\dist\workflow-view\*.js"
          LinkBase="dist\workflow-view"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
